{
  "name": "maxbet-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@maxbet/web",
    "start": "npm run start --workspace=@maxbet/web",
    "build": "npm run build --workspace=@maxbet/web",
    "lint": "npm run lint --workspace=@maxbet/web",
    "typecheck": "npm run typecheck --workspace=@maxbet/web"
  },
  "devDependencies": {
    "next": "15.5.26"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
